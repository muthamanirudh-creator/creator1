# ai-ml-service/.env  (copy this file to .env; every value is optional — the service boots with none of them)
# When the portal backend auto-starts this service, it passes the Admin-saved keys/token in itself.

# --- Service ---
ENV=development                 # set to "production" on Render (then AI_ML_SERVICE_TOKEN below is REQUIRED)
PORT=8000
CORS_ORIGINS=*                  # production: your real frontend origin(s), comma separated
# Must be IDENTICAL to AI_ML_SERVICE_TOKEN on the portal backend (Vercel) — or paste it in Admin -> Settings.
AI_ML_SERVICE_TOKEN=

# --- LLM providers (Groq is tried first, then Gemini) ---
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
AI_PROVIDER_ORDER=groq,gemini
AI_REQUEST_TIMEOUT_S=30         # per single provider call
AI_MAX_RETRIES=2
AI_TOTAL_DEADLINE_S=38          # overall cap for one AI request (must stay below the gateway's ~45-55 s budget)
AI_DISABLE_RESPONSE_CACHE=true  # live mode: generate a fresh AI answer for each user request

# --- Semantic matching (Career Fit tab, resume/JD match, skill gap, role resolution) ---
# Real transformer embeddings (sentence-transformers + transformers + torch). Needs ~1 GB RAM.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # any sentence-transformers model, e.g. BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_PATH=           # optional local folder with a saved copy of the model (offline / air-gapped hosts)
EMBEDDING_DEVICE=auto           # auto | cpu | cuda | mps
EMBEDDING_WARMUP=true           # load the model in the background at start-up
EMBEDDING_LOAD_TIMEOUT_S=300    # how long a request waits for the very first load
EMBEDDING_CACHE_SIZE=8192       # cached vectors (makes the live "as you type" panel cheap)
# STRICT (default): if the model cannot load, semantic endpoints answer 503 EMBEDDING_MODEL_UNAVAILABLE.
# true = emergency opt-in for hosts that cannot run torch: falls back to hashed word-overlap and flags every result.
ALLOW_LEXICAL_FALLBACK=false
# Calibration of "has the skill" decisions (cosine similarity). Tune with `python scripts/verify_semantic.py`.
SEMANTIC_STRONG_THRESHOLD=0.75
SEMANTIC_PARTIAL_THRESHOLD=0.55
SEMANTIC_PASSAGE_MATCH=0.55
SEMANTIC_PASSAGE_PARTIAL=0.40
SEMANTIC_ROLE_THRESHOLD=0.60

# --- Speech-to-text ---
WHISPER_PROVIDER=groq           # groq | local (local needs faster-whisper, Python 3.11/3.12)
WHISPER_MODEL=whisper-large-v3

# --- Sessions / limits ---
ADAPTIVE_SESSION_TTL_S=3600
INTERVIEW_SESSION_TTL_S=3600
SESSION_MAX_ENTRIES=500
MAX_UPLOAD_MB=10
ANALYSIS_MAX_AUDIO_S=180
ANALYSIS_MAX_VIDEO_FRAMES=240

# --- Render free tier keep-warm (RENDER_EXTERNAL_URL is set by Render itself) ---
KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_S=600

# --- Optional live job-market data (offline dataset is used when blank) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JSEARCH_RAPIDAPI_KEY=

# --- Career Fit RAG (Ask Career Fit tab) ---
RAG_TOP_K=6                  # passages given to the LLM per question (1-12)
RAG_MIN_SIMILARITY=0.22      # cosine below which a passage is not treated as evidence (tune with the model)
RAG_MAX_CONTEXT_CHARS=6500   # size budget of the retrieved context block
RAG_DENSE_WEIGHT=1.0         # weight of embeddings in the rank fusion
RAG_LEXICAL_WEIGHT=0.6       # weight of BM25 keywords in the rank fusion
RAG_KB_DIR=                  # extra .md/.txt/.json knowledge files; blank = data/rag_kb
HYBRID_RAG_MIN_RELEVANCE=0.30            # shared hybrid RAG: abstain when the best passage is less similar than this
HYBRID_RAG_CACHE_TTL_SECONDS=300         # per-user answer cache lifetime
HYBRID_RAG_LLM_TIMEOUT_SECONDS=30
HYBRID_RAG_ALLOW_UNVERIFIED_FACTS=false  # keep false: recruitment facts need an official source
HYBRID_RAG_MAX_VERIFICATION_AGE_DAYS=7     # a drive not re-verified within this many days is labelled "unverified", not "active"
HYBRID_RAG_OFFICIAL_DOMAINS=               # extra official domain suffixes (comma separated); gov.in / nic.in are built in
HYBRID_RAG_RECORDS_PATH=                   # optional path for a JSON snapshot of PUBLIC recruitment records (never student data)
HYBRID_RAG_USE_LANGCHAIN=auto             # off | auto | on. LCEL orchestration of the answer-generation step; "auto" uses it only when langchain-core is installed, "on" refuses to start without it
HYBRID_RAG_KNOWLEDGE_PATH=               # Pass B: JSON snapshot of PUBLIC private/exam/learning/career documents (never student data); blank = next to the records snapshot
HYBRID_RAG_ANSWER_KEYS_PATH=             # Pass B: answer-key vault file, kept OUT of the shared index (written mode 0600); blank = next to the knowledge snapshot
HYBRID_RAG_KNOWLEDGE_DIR=                # Pass B: optional folder of *.json knowledge items loaded at start-up
HYBRID_RAG_HIRING_WINDOW_DAYS=365        # Pass B: private-sector hiring info not verified within this many days is labelled "historical"
HYBRID_RAG_EXAM_WINDOW_DAYS=730          # Pass B: same for exam pattern / syllabus / cutoff information
HYBRID_RAG_RERANKER=auto                 # off | lexical | cross-encoder | auto (cross-encoder if sentence-transformers is installed, else lexical)
HYBRID_RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HYBRID_RAG_VECTORS_PATH=                 # .npz cache of chunk embeddings (avoids re-embedding after a restart); blank = next to the records snapshot
