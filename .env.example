# GovCareer AI configuration
PORT=3000
NODE_ENV=production
# Optional production persistence. If unavailable, the public intelligence layer starts in resilient demo mode.
# PostgreSQL (same database + Prisma schema as the P1 portal). Neon/Supabase/Render Postgres all work.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/campus_portal?schema=public
# Non-pooled connection used only for `prisma migrate deploy` (leave empty if DATABASE_URL is already direct).
DIRECT_URL=
DB_CONNECTION_TIMEOUT_MS=2000
# Optional AI enhancement. The grounded deterministic engine works without these keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDERS=groq,gemini
PRIVACY_POLICY_VERSION=2026-01
CRAWLER_CONTACT=

# Unified Campus Portal
CAMPUS_PORT=3101
DISABLE_CAMPUS_PORTAL=0
# Campus-specific secrets can be supplied using the same environment used by campus/backend.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PORTAL_SECRETS_ENCRYPTION_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
AI_ML_SERVICE_URL=http://127.0.0.1:8000
AI_ML_SERVICE_TOKEN=
AI_ML_AUTOSTART=true

# Bridge (GovCareer <-> Campus). In unified mode a per-boot secret is generated automatically; set a fixed
# value (>= 32 chars, identical on both services) when they are deployed separately or must survive restarts.
BRIDGE_SERVICE_SECRET=
# Only when Campus runs as a separate service reachable from the GovCareer server:
CAMPUS_HOST=
BRIDGE_CAMPUS_TIMEOUT_MS=8000

# Single login (v2.4)
# REQUIRE_LOGIN=1        # 1 = always redirect GovCareer to the Campus login when signed out; 0 = never
# LEGACY_ACCOUNT_LOGIN=1 # re-enable the old password endpoints (tests only)

# Observability (v2.7). Every response carries X-Request-Id. Set to 1 to emit one structured JSON log line per request
# (route pattern, status, latency only; never bodies, headers, tokens or query strings). 5xx responses are always logged.
LOG_REQUESTS=0

# ---- v2.8.2 Automatic monitoring (all optional; sensible defaults) ----
# The scheduler runs inside the web server. Set 0 to run it only in `node worker.js`.
RUN_WORKER_INLINE=1
# Official sources are checked about every N minutes (per source: sources.crawl_frequency_minutes, default 30).
SCHEDULE_TICK_SECONDS=60
# Publish cited, high-confidence notices from verified official sources without waiting for a person (labelled "auto-extracted").
AUTO_PUBLISH=1
AUTO_PUBLISH_MIN_CONFIDENCE=0.85
AUTO_PUBLISH_MAX_STALE_DAYS=30
# Backlog read the first time a source is seen, and the per-run cap afterwards.
INITIAL_BACKFILL=15
MAX_NEW_PER_CRAWL=25
# Extra official domains (comma separated) accepted by source auto-verification, e.g. a university: iitm.ac.in
OFFICIAL_DOMAIN_EXTRA=
# Send people who open the bare GovCareer URL to the Campus sub-tab (default). 1 = keep GovCareer's own entry page.
GOVCAREER_STANDALONE_ENTRY=0
# Channel broadcast of new notices / extensions / amendments (secrets stay in the environment, never in code).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_BROADCAST_TO=
BROADCAST_UNVERIFIED=0

# ---- v2.10.0 national coverage + instant alerts ----
# Web Push (phone/browser notifications). Leave empty to auto-generate one key pair stored in the database.
# Generate your own with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Public https URL of this site (used in the Atom feed and push subject)
PUBLIC_BASE_URL=
# Set to 0 to disable push
WEB_PUSH=1
# Seconds between push dispatch passes (default 10)
PUSH_TICK_SECONDS=10
# Minutes between checks per tier (defaults 5 / 10 / 20). Be polite to government servers; do not go below 2.
CRAWL_MINUTES_T1=5
CRAWL_MINUTES_T2=10
CRAWL_MINUTES_T3=20
# Hours between retries of sources that are still pending verification (default 1)
SOURCE_VERIFY_HOURS=1

# --- Hybrid RAG record sync (v2.9.1): GovCareer database -> AI service -------------------------------------------------
# Pushes PUBLISHED, non-sample recruitments with their stored notice text and the source's last successful verification time.
# Needs AI_ML_SERVICE_URL and AI_ML_SERVICE_TOKEN (same values the Campus gateway uses). Manual: npm run hybrid:sync
# The AI service holds the index in memory; it is rebuilt from a snapshot (HYBRID_RAG_RECORDS_PATH) and, if the service restarts
# EMPTY, the scheduler re-syncs within ~2 minutes (HYBRID_RAG_RECOVER_SECONDS). Point the path at PERSISTENT storage in production.
HYBRID_RAG_SYNC_MINUTES=30                # 0 = off; 30 = full sync every 30 minutes (scheduler leader only). Unset in code = off.
HYBRID_RAG_RECOVER_SECONDS=120
HYBRID_RAG_RECORDS_PATH=                  # e.g. /data/hybrid_rag/records.json (mounted disk). Blank = ./data/hybrid_rag/records.json (ephemeral on most hosts)
HYBRID_RAG_RERANKER=auto                  # off | lexical | cross-encoder | auto
HYBRID_RAG_SYNC_TIMEOUT_MS=20000
HYBRID_RAG_SYNC_BATCH=20
